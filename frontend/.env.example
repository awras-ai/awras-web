# Backend
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000/

# Chat Platform
NEXT_PUBLIC_CHAT_PLATFORM_URL=http://localhost:3000/chat

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keycloak (keycloak-js — all values are public/client-side)
# The Keycloak server base URL (no realm path)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# The realm name configured in Keycloak
NEXT_PUBLIC_KEYCLOAK_REALM=awras
# The client ID — must be a PUBLIC client (Client authentication: Off) in Keycloak
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=awras-frontend
