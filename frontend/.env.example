# Database Configuration
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000/

# Chat Platform Configuration
NEXT_PUBLIC_CHAT_PLATFORM_URL=http://localhost:3000/chat

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Keycloak (OIDC)
KEYCLOAK_CLIENT_ID=awras-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/awras

# Keycloak (client-side, for logout redirect)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/awras
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=awras-frontend
