# Application Settings
APP_NAME="AWRAS API"
APP_VERSION="1.0.0"
DEBUG=false

# Database Configuration
# Use localhost for local development
#NOTE: the conatiner name should be insead of localhost when dockerizing the app
DATABASE_URL="postgresql://awras_user:awras_password@postgres:5432/awras"

# Redis url
REDIS_URL="redis://redis:6379"

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost","http://localhost:5173"]

MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TEMPERATURE=
MODEL_CUSTOM_HEADER_KEY=
MODEL_CUSTOM_HEADER_VALUE=

# API Settings
API_V1_PREFIX="/api/v1"

POSTGRES_DB=awras
POSTGRES_USER=awras_user
POSTGRES_PASSWORD=awras_password

# frontend dependencies
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000/
VITE_API_URL=http://localhost:8000/
# Docker Compose Ports
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_OUTSIDE_PORT=5555

# =============================================================================
# Authentication Settings
# =============================================================================

# Session Configuration
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=""
SESSION_COOKIE_NAME="session_id"
SESSION_COOKIE_SECURE=false # Set to true in production (HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax" # "lax", "strict", or "none"
SESSION_COOKIE_DOMAIN=""      # Leave empty for localhost
SESSION_EXPIRE_DAYS=15

# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Email Verification
# Set to true to require email verification before login
REQUIRE_EMAIL_VERIFICATION=false

# Frontend URL (for verification links and redirects)
FRONTEND_URL="http://localhost:5173"

# =============================================================================
# Chainlit Settings
# =============================================================================

# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=""

# bucket credentials for storing user profiles in R2
R2_ENDPOINT_URL="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your_access_key_id>"
R2_SECRET_ACCESS_KEY="<your_secret_access_key>"
R2_BUCKET_NAME="awras-profiles"

# Langfuse tracability
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
