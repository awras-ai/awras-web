# =============================================================================
# AWRAS — Root environment configuration
# Consumed by docker-compose.yml / docker-compose.dev.yml
# Copy to .env and fill in your values: cp .env.example .env
#
# NOTE: backend/.env and frontend/.env are used for local non-Docker dev.
# =============================================================================

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=awras
POSTGRES_USER=awras_user
POSTGRES_PASSWORD=awras_password
# Host port the database is published on (prod compose only; dev uses 5432)
POSTGRES_OUTSIDE_PORT=5555
# Container hostname/port — only change if you rename the postgres service
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# =============================================================================
# Backend (FastAPI)
# =============================================================================
DEBUG=false
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost","http://localhost:5173"]
BACKEND_PORT=8000

# Cloudflare R2 object storage
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=awras-profiles

# =============================================================================
# Keycloak — Server
# =============================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
# Generate a strong password for production: openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=
# Name of the Keycloak database
# WARNING: must match infra/postgres-init/00-create-keycloak-db.sql
KEYCLOAK_DB_NAME=keycloak
# Path to the custom Keycloak theme build
KEYCLOAK_THEME_PATH=./keycloak-theme/dist_keycloak

# =============================================================================
# Keycloak — Backend client (confidential, server-side token validation)
# =============================================================================
KEYCLOAK_ISSUER=http://localhost:8080/realms/awras
KEYCLOAK_BACKEND_CLIENT_ID=awras-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=

# =============================================================================
# Frontend (Next.js) — all NEXT_PUBLIC_* values are public/browser-exposed
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000/
# Where users are redirected after login (chat platform)
NEXT_PUBLIC_CHAT_PLATFORM_URL=http://localhost:3000/chat

# Keycloak — Frontend client (must be a PUBLIC client in Keycloak)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=awras
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=awras-frontend

# PostHog analytics (leave the token empty to disable)
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# Production only (docker-compose.yml) — not needed for local development
# =============================================================================
# Public hostname of the Keycloak server
# KEYCLOAK_HOSTNAME=https://auth.example.com
# KC_HOSTNAME_ADMIN=https://auth.example.com
# KC_HOSTNAME_STRICT=true
# KC_HOSTNAME_STRICT_HTTPS=true
# KEYCLOAK_PROXY=edge
# KEYCLOAK_LOG_LEVEL=info
