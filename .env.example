# Application Settings
APP_NAME="AWRAS API"
APP_VERSION="1.0.0"
DEBUG=false

# Database Configuration
# Use localhost for local development
#NOTE: the conatiner name should be insead of localhost when dockerizing the app
DATABASE_URL="postgresql://awras_user:awras_password@postgres:5432/awras"

# Redis url
REDIS_URL="redis://redis:6379"

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost","http://localhost:5173"]

MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TEMPERATURE=
MODEL_CUSTOM_HEADER_KEY=
MODEL_CUSTOM_HEADER_VALUE=

# API Settings
API_V1_PREFIX="/api/v1"

POSTGRES_DB=awras
POSTGRES_USER=awras_user
POSTGRES_PASSWORD=awras_password

# frontend dependencies
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000/
VITE_API_URL=http://localhost:8000/

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Keycloak (OIDC)
KEYCLOAK_CLIENT_ID=awras-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/awras

# Keycloak (client-side, for logout redirect)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/awras
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=awras-frontend

# Docker Compose Ports
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_OUTSIDE_PORT=5555

# Keycloak (backend-side OIDC validation)
KEYCLOAK_BACKEND_CLIENT_ID=awras-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=""

# bucket credentials for storing user profiles in R2
R2_ENDPOINT_URL="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your_access_key_id>"
R2_SECRET_ACCESS_KEY="<your_secret_access_key>"
R2_BUCKET_NAME="awras-profiles"

# Langfuse tracability
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

NEXT_PUBLIC_POSTHOG_TOKEN=posthog_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# Keycloak Settings
# =============================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
# Generate a strong password: openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=""
KEYCLOAK_REALM=awras
KEYCLOAK_FRONTEND_CLIENT_ID=awras-frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=""
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_THEME_PATH=./keycloak-theme/dist_keycloak
